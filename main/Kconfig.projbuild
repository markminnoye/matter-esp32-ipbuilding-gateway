menu "IPBuilding Gateway"

    config WIFI_SSID
        string "WiFi SSID (home LAN, Matter commissioning)"
        default "YOUR_SSID"
        help
            Home LAN WiFi network used for Matter over WiFi.

    config WIFI_PASSWORD
        string "WiFi password"
        default "YOUR_PASSWORD"
        help
            WiFi password. Set via menuconfig — never commit sdkconfig with real credentials.

    config ETH_STATIC_IP
        string "Field-bus Ethernet IP"
        default "10.10.1.1"
        help
            Static IP on the IPBuilding VLAN (W5500 interface).

    config ETH_STATIC_GW
        string "Field-bus Ethernet gateway"
        default "10.10.1.1"

    config ETH_STATIC_NETMASK
        string "Field-bus Ethernet netmask"
        default "255.255.255.0"

    config MATTER_BRIDGE_NODE_LABEL
        string "Matter bridge name (NodeLabel)"
        default "IPBuilding Gateway"
        help
            User-visible name for the root Matter node in Apple Home / HA (Basic
            Information NodeLabel, max 32 characters). Change via menuconfig;
            already-commissioned fabrics may keep the old name until re-added.

    config VELDBUS_POLL_INTERVAL_MS
        int "Veldbus poll interval (ms)"
        default 2000
        range 500 10000
        help
            Time between module poll cycles (relay P0000 keepalive, dimmer
            I9900, input I0000). Relay channel status is NOT polled here —
            boot sweep seeds initial state; runtime updates are unsolicited
            status lines on the rx task (Python gateway parity).

endmenu
